# --- App ---
APP_NAME="Banking RAG Assistant"
APP_ENV=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false                # true in production for structured logs

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM key for field-level encryption at rest (backend.security.encryption)
# — generate with: python -c "from backend.security.encryption import generate_key; print(generate_key())"
# Leave blank in dev (a key is derived from SECRET_KEY); ALWAYS set an
# independent value in staging/production so rotating SECRET_KEY doesn't
# also silently rotate the encryption key.
ENCRYPTION_KEY=

# Brute-force lockout (backend.services.auth_service.AuthService).
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# OAuth2 token endpoint advertised to Swagger's "Authorize" button — must match
# API_V1_PREFIX + the auth router's mount path.
OAUTH2_TOKEN_URL=api/v1/auth/token

# --- Database ---
# SQLite for local dev:
DATABASE_URL=sqlite+aiosqlite:///./banking_rag.db
# Postgres for production (see docker-compose.yml / k8s/base for the managed
# equivalents — POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below feed the
# `postgres` service itself, DATABASE_URL is what the backend connects with):
# DATABASE_URL=postgresql+asyncpg://banking_rag:change-me@postgres:5432/banking_rag
POSTGRES_USER=banking_rag
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=banking_rag

# --- OpenAI chat (backend.llm.client) ---
# OPENAI_API_KEY itself is set once, below, in the Embeddings section — shared
# between chat completions and embeddings (one OpenAI account for both).
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_MAX_TOKENS=2048
OPENAI_CHAT_TEMPERATURE=0.3

# --- Vector store ---
VECTOR_STORE_PROVIDER=faiss     # faiss | pinecone
FAISS_INDEX_DIR=./vector_db/faiss_indices
# Must match the active embedding provider's dimension (openai=3072, bge_large=1024,
# instructor_xl=768) — EmbeddingService raises a clear error on mismatch. Defaults to
# 3072 because EMBEDDING_PROVIDER=auto picks OpenAI first whenever OPENAI_API_KEY is
# set (see backend.retrieval.embeddings.selector) — change this only if you also
# switch EMBEDDING_PROVIDER to bge_large/instructor_xl.
EMBEDDING_DIM=3072
FAISS_INDEX_FACTORY=Flat          # Flat | HNSW32 | IVF100,Flat (see config.py notes)
FAISS_FILTER_OVERFETCH_FACTOR=5
FAISS_MAX_FILTER_RETRIES=5
FAISS_HYBRID_RRF_K=60

PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=banking-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine           # cosine | dotproduct | euclidean
PINECONE_CREATE_INDEX_IF_MISSING=true
PINECONE_NAMESPACE=
PINECONE_BM25_REBUILD_LIMIT=10000

# --- Embeddings ---
EMBEDDING_PROVIDER=auto          # auto | openai | bge_large | instructor_xl
# Used for both chat completions (backend.llm.client) and embeddings below.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=3072
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5
BGE_EMBEDDING_DIM=1024
INSTRUCTOR_MODEL_NAME=hkunlp/instructor-xl
INSTRUCTOR_EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_CACHE_BACKEND=redis    # redis | memory | none
EMBEDDING_CACHE_TTL_SECONDS=2592000
REDIS_URL=redis://localhost:6379/0

# --- RAG ---
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_RETRIEVAL_MODE=hybrid        # vector | hybrid — only used when RAG_RETRIEVAL_ENGINE=native
RAG_RETRIEVAL_ENGINE=enterprise  # native | enterprise

# --- Enterprise retrieval (LangChain-based) ---
ENTERPRISE_DENSE_TOP_K=20
ENTERPRISE_BM25_TOP_K=20
ENTERPRISE_ENSEMBLE_WEIGHTS=[0.5, 0.5]
ENTERPRISE_MULTI_QUERY_ENABLED=false
ENTERPRISE_MULTI_QUERY_COUNT=3
ENTERPRISE_RERANKING_ENABLED=true
ENTERPRISE_RERANKER_PROVIDER=auto  # auto | bge | cross_encoder
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CROSS_ENCODER_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENTERPRISE_RERANK_TOP_N=5
ENTERPRISE_RERANKER_MIN_RELEVANCE_SCORE=0.1
ENTERPRISE_INTELLIGENT_RANKING_ENABLED=true
ENTERPRISE_RECENCY_BOOST_WEIGHT=0.05
ENTERPRISE_RECENCY_HALF_LIFE_DAYS=180.0
ENTERPRISE_STRUCTURAL_CONTEXT_BOOST_WEIGHT=0.02
ENTERPRISE_BM25_CACHE_TTL_SECONDS=300

# --- Chunking ---
CHUNKING_STRATEGY=hybrid          # fixed | recursive | semantic | hybrid
CHUNKING_MAX_CHARS=1000
CHUNKING_MIN_CHARS=200
CHUNKING_OVERLAP_SENTENCES=2
CHUNKING_SEMANTIC_BREAKPOINT_PERCENTILE=95.0
CHUNKING_SEMANTIC_MIN_UNITS=6

# --- Rate limiting / uploads ---
MAX_UPLOAD_SIZE_MB=20
DOCUMENT_STORAGE_DIR=./storage/documents

# --- Monitoring stack (docker-compose.yml / k8s only — not read by the backend) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-string
# Alertmanager routes to Slack by default (monitoring/alertmanager/alertmanager.yml)
# — leave blank to disable that receiver rather than send to a dead webhook.
ALERTMANAGER_SLACK_WEBHOOK_URL=
