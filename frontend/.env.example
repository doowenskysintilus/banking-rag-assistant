# Base URL for the FastAPI backend's API. Leave empty to use relative paths
# (works with the Vite dev server's proxy — see vite.config.ts — or a
# same-origin reverse proxy in production). Set an absolute URL only for a
# cross-origin deployment (the backend's CORS_ORIGINS must then allow this
# frontend's origin — see ../.env.example).
VITE_API_BASE_URL=
